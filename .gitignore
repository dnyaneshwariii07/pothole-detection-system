# ── Dependencies ──
node_modules/
**/node_modules/

# ── Build output ──
dist/
build/

# ── Environment variables (NEVER commit these) ──
.env
.env.local
.env.production
backend/.env

# ── Python ──
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
venv/
backend/venv/
*.egg-info/

# ── Database ──
*.db
backend/*.db

# ── Uploads (local images) ──
backend/uploads/*
!backend/uploads/.gitkeep

# ── OS files ──
.DS_Store
Thumbs.db

# ── IDE ──
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# ── Logs ──
*.log
npm-debug.log*
